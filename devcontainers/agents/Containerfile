FROM ghcr.io/vincentvibe3/dev-fedora-tbx:latest

ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN dnf install -y fuse fuse-libs

# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && dnf update -y \
    && dnf install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

ENV DISTROBOX_USER=$USERNAME
ENV HOME=/home/${USERNAME}
ENV CONTAINER_ID=agents-devcontainer
ENV SHELL=/usr/bin/fish

COPY setup /usr/share/container-setup/

# Make all init-scripts executable
RUN /usr/share/container-setup/chmod-setup.sh

RUN /usr/share/container-setup/init.sh

USER $USERNAME